USE_PROCD=1
START=80

write_daemon_config() {
  local cfg_file="$1"
  local netfilter_mode
  local no_stateful_filtering
  local app_connector_advertise
  local auto_update_check
  local auto_update_apply

  config_get netfilter_mode "daemon_settings" netfilter_mode ""
  config_get no_stateful_filtering "daemon_settings" no_stateful_filtering ""
  config_get app_connector_advertise "daemon_settings" app_connector_advertise ""
  config_get auto_update_check "daemon_settings" auto_update_check ""
  config_get auto_update_apply "daemon_settings" auto_update_apply ""

  case "$netfilter_mode" in
    on|nodivert|off) ;;
    *)
      logger -t tailscale "Invalid netfilter_mode '$netfilter_mode'; falling back to 'on'"
      netfilter_mode="on"
      ;;
  esac

  json_init
  json_add_string "version" "alpha0"
  json_add_uci_string "serverURL" "daemon_settings" "server_url"
  json_add_uci_string "authKey" "daemon_settings" "auth_key"
  json_add_uci_boolean "locked" "daemon_settings" "locked"
  json_add_uci_boolean "enabled" "daemon_settings" "enabled"
  json_add_uci_string "hostname" "daemon_settings" "hostname"
  json_add_uci_string "operatorUser" "daemon_settings" "operator_user"
  json_add_uci_boolean "acceptDNS" "daemon_settings" "accept_dns"
  json_add_uci_boolean "acceptRoutes" "daemon_settings" "accept_routes"
  json_add_uci_array "advertiseRoutes" "daemon_settings" "advertise_routes"
  json_add_uci_boolean "disableSNAT" "daemon_settings" "disable_snat"
  json_add_uci_string "exitNode" "daemon_settings" "exit_node"
  json_add_uci_boolean "allowLANWhileUsingExitNode" "daemon_settings" "allow_lan_while_using_exit_node"
  json_add_uci_boolean "runSSHServer" "daemon_settings" "run_ssh_server"
  json_add_uci_boolean "runWebClient" "daemon_settings" "run_web_client"
  json_add_uci_boolean "shieldsUp" "daemon_settings" "shields_up"
  json_add_uci_boolean "postureChecking" "daemon_settings" "posture_checking"
  json_add_uci_array "advertiseServices" "daemon_settings" "advertise_services"

  if [ -n "$app_connector_advertise" ]; then
    json_add_object "appConnector"
    json_add_uci_boolean "advertise" "daemon_settings" "app_connector_advertise"
    json_close_object
  fi

  if [ -n "$auto_update_check" ] || [ -n "$auto_update_apply" ]; then
    json_add_object "autoUpdate"
    json_add_uci_boolean "check" "daemon_settings" "auto_update_check"
    json_add_uci_boolean "apply" "daemon_settings" "auto_update_apply"
    json_close_object
  fi

  json_add_string "netfilterMode" "$netfilter_mode"
  if [ -n "$no_stateful_filtering" ]; then
    case "$no_stateful_filtering" in
      1|on|true|yes) json_add_boolean "noStatefulFiltering" "1" ;;
      0|off|false|no) json_add_boolean "noStatefulFiltering" "0" ;;
      *) logger -t tailscale "Ignoring invalid no_stateful_filtering value '$no_stateful_filtering'" ;;
    esac
  fi
  json_add_uci_array "staticEndpoints" "daemon_settings" "static_endpoints"
  json_dump > "$cfg_file"
}

start_service() {
  local state_file default_state_file
  local port
  local cfg_file cfg_dir
  local std_err std_out
  local fw_mode

  config_load tailscale
  config_get_bool std_out "settings" log_stdout 1
  config_get_bool std_err "settings" log_stderr 1
  config_get port "settings" port 41641
  config_get cfg_file "settings" tailscaled_config_file /var/run/tailscale/tailscaled-config.hujson
  config_get fw_mode "settings" fw_mode ""

  # fw_mode selected iptables vs nftables through TS_DEBUG_FIREWALL_MODE.
  # The daemon config file does not expose that setting; keep a warning for migration.
  case "$fw_mode" in
    ""|nftables)
      fw_mode="nftables"
      ;;
    *)
      logger -t tailscale "Ignoring deprecated fw_mode '$fw_mode'; use daemon_settings.netfilter_mode"
      ;;
  esac

  procd_set_param env TS_DEBUG_FIREWALL_MODE="$fw_mode"

  case "$cfg_file" in
    */*) cfg_dir="${cfg_file%/*}" ;;
    *)
      cfg_dir="/var/run/tailscale"
      cfg_file="$cfg_dir/$cfg_file"
      ;;
  esac

  default_state_file="/etc/tailscale/tailscaled.state"
  config_get state_file "settings" state_file "$default_state_file"

  mkdir -p "$cfg_dir"

  write_daemon_config "$cfg_file"

  /usr/sbin/tailscaled --cleanup

  procd_open_instance
  procd_set_param command /usr/sbin/tailscaled

  # Tailscaled's config file is loaded with --config. Some daemon-level settings
  # (for example --state and --port) are currently flag-only.
  procd_append_param command --config "$cfg_file"

  # Set the port to listen on for incoming VPN packets.
  # Remote nodes will automatically be informed about the new port number,
  # but you might want to configure this in order to set external firewall
  # settings.
  procd_append_param command --port "$port"
  #procd_set_param env TAILSCALED_TUN="userspace-networking"
  procd_append_param command --state "$state_file"

  procd_set_param respawn
  procd_set_param stdout "$std_out"
  procd_set_param stderr "$std_err"

  procd_close_instance
}

stop_service() {
  /usr/sbin/tailscaled --cleanup
}
