#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99

DOCKER_CONF_DIR="/tmp/dockerd"
DOCKERD_CONF="${DOCKER_CONF_DIR}/daemon.json"

# Include OpenWrt JSON and your local helpers
. /usr/share/libubox/jshn.sh
. /usr/share/docker/uci_json.sh  # Update this path to where uci_json.sh is stored

uci_quiet() {
	uci -q "${@}" >/dev/null
}

boot() {
	rc_procd start_service
}

process_config() {
	local alt_config_file

	[ -f /etc/config/dockerd ] || {
		DOCKERD_CONF=""
		return 0
	}

	# Reset configuration directory
	rm -fr "${DOCKER_CONF_DIR}"
	mkdir -p "${DOCKER_CONF_DIR}"

	config_load 'dockerd'
	
	# Check for alternative config file first
	config_get alt_config_file globals alt_config_file
	[ -n "${alt_config_file}" ] && [ -f "${alt_config_file}" ] && {
		ln -s "${alt_config_file}" "${DOCKERD_CONF}"
		return 0
	}

	# Initialize JSON object
	json_init
	
	# Mapping UCI 'globals' section to JSON
	json_add_uci_string "data-root" "globals" "data_root"
	json_add_uci_string "exec-root" "globals" "exec_root"
	json_add_uci_string "log-level" "globals" "log_level"
	json_add_uci_string "log-driver" "globals" "log_driver"
	json_add_uci_string "storage-driver" "globals" "storage_driver"
	json_add_uci_string "bip" "globals" "bip"
	json_add_uci_string "ip" "globals" "ip"
	json_add_uci_string "fixed-cidr" "globals" "fixed_cidr"
	json_add_uci_string "fixed-cidr-v6" "globals" "fixed_cidr_v6"
	
	# Firewall and IPTables (Hardcoded or UCI based)
	json_add_boolean "iptables" "1"
	json_add_boolean "ip6tables" "1"
	json_add_uci_string "firewall-backend" "globals" "firewall_backend"

	# Boolean values
	json_add_uci_boolean "ipv6" "globals" "ipv6"
	json_add_uci_boolean "userland-proxy" "globals" "userland_proxy"

	# Arrays
	json_add_uci_array "registry-mirrors" "globals" "registry_mirrors"
	json_add_uci_array "hosts" "globals" "hosts"
	json_add_uci_array "dns" "globals" "dns"

	# Proxies (Nested Object)
	local h_proxy s_proxy n_proxy
	config_get h_proxy proxies http_proxy "${http_proxy}"
	config_get s_proxy proxies https_proxy "${https_proxy}"
	config_get n_proxy proxies no_proxy "${no_proxy}"

	if [ -n "$h_proxy" ] || [ -n "$s_proxy" ] || [ -n "$n_proxy" ]; then
		json_add_object "proxies"
		[ -n "$h_proxy" ] && json_add_string "http-proxy" "$h_proxy"
		[ -n "$s_proxy" ] && json_add_string "https-proxy" "$s_proxy"
		[ -n "$n_proxy" ] && json_add_string "no-proxy" "$n_proxy"
		json_close_object
	fi

	# Export to file
	json_dump > "${DOCKERD_CONF}"
}

start_service() {
	local nofile=$(cat /proc/sys/fs/nr_open)

	process_config

	procd_open_instance
	procd_set_param stderr 1
	if [ -z "${DOCKERD_CONF}" ]; then
		procd_set_param command /usr/bin/dockerd
	else
		procd_set_param command /usr/bin/dockerd --config-file="${DOCKERD_CONF}"
	fi
	procd_set_param limits nofile="${nofile} ${nofile}"
	procd_close_instance
}

reload_service() {
	process_config
	procd_send_signal dockerd
}

service_triggers() {
	procd_add_reload_trigger 'dockerd'
}

stop_service() {
	if /etc/init.d/dockerd running; then
		service_stop "/usr/bin/dockerd"
	fi
}